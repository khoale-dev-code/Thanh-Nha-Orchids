# Không điền thông tin thật vào ZIP hoặc commit lên Git.
# Nếu bỏ trống URL và khóa Supabase, ứng dụng chạy CHẾ ĐỘ DEMO trên trình duyệt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chỉ cấu hình sau khi ký hợp đồng và nhận credentials EMS/Vietnam Post.
# Bật true khi đã kiểm thử API trên môi trường được EMS xác nhận.
VNPOST_ENABLED=false
EMS_API_TOKEN=
EMS_CUSTOMER_CODE=
EMS_SENDER_CODE=
EMS_SENDER_PROVINCE_ID=
EMS_SENDER_DISTRICT_ID=
EMS_SENDER_WARD_ID=
# Không được nhầm Viettel Post với VNPost/EMS.
